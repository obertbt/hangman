# =============================================================================
# Hearth Growth 環境変数
# =============================================================================
# このファイルをコピーして .env.local を作ってください。
#   cp .env.example .env.local
# .env.local は Git にコミットしません（.gitignore 済み）。

# Supabase プロジェクトの URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon key。ブラウザに出てよい鍵はこれだけです。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# メール内リンクのリダイレクト先などに使います。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# service role key は絶対にここへ書かず、クライアントへも渡さないでください。
# RLS を迂回できるため、必要になった場合もサーバー専用の実行環境にだけ置きます。
# -----------------------------------------------------------------------------
