# =============================================================
# 慶應ホッケーハブ (Keio Hockey Hub) 環境変数
#
# このファイルをコピーして .env.local を作る。
#   cp .env.example .env.local
#
# 重要: NEXT_PUBLIC_ で始まる値はブラウザへそのまま配られる。
#       秘密情報を NEXT_PUBLIC_ へ入れてはいけない。
# =============================================================

# --- アプリ表示名（1章: 表示名は環境変数から変更可能にする） ---
NEXT_PUBLIC_APP_NAME=慶應ホッケーハブ
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key はサーバー専用。ブラウザへ渡してはいけない。
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (S3 互換) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- 容量・制限（58章） ---
MAX_VIDEO_DURATION_SECONDS=60
MAX_VIDEO_SIZE_BYTES=52428800
MAX_DAILY_VIDEO_UPLOADS_PER_USER=5

MAX_IMAGE_SIZE_BYTES=2097152
MAX_PDF_SIZE_BYTES=10485760

SIGNED_URL_EXPIRY_SECONDS=900

TEMP_UPLOAD_RETENTION_HOURS=24
DELETED_FILE_RETENTION_DAYS=30

# --- インポート制限（37章） ---
MAX_IMPORT_FILE_SIZE_BYTES=10485760
MAX_IMPORT_ROWS=10000

# 保存容量の目安（59章）。既定は 25GB。
# R2 の上限ではなく「これを超えたら見直す」という自分たちの線引き。
# 0 にすると割合を出さず、使用量だけを表示します。
STORAGE_LIMIT_BYTES=26843545600
